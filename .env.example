# ---------------------------------------------------------------------------
# Travio Ghana — Stays supplier dashboard
# Copy to `.env.local` and fill in only what you need. Everything here is
# optional: a fresh clone runs on the bundled demo data with no backend.
#
# Every `VITE_*` value is inlined into the PUBLIC browser bundle.
# Server-side secrets never belong in this repo or in any `.env` it reads —
# e.g. GOOGLE_CLIENT_SECRET, OAuth callback config, SerpApi keys. Keep those on
# the backend. (The build fails if client code references VITE_SERP_API_KEY;
# see vite.config.ts.)
# ---------------------------------------------------------------------------

# Where the Stays workspace reads its data from. Exactly one of:
#   mock — the bundled demo dataset, with a demo owner session (no backend)
#   api  — the live supplier API
# Defaults: `mock` in development, `api` in a production build.
# Any other value stops the app at startup. A production build also refuses
# `mock` unless VITE_ALLOW_MOCK_IN_PROD=true (a deliberate public demo).
VITE_STAYS_DATA_SOURCE=mock
VITE_ALLOW_MOCK_IN_PROD=false

# Dev write guard. A development build with VITE_STAYS_DATA_SOURCE=api talks
# to the real backend, so it only sends reads (sign-in excepted): saves are
# blocked with a toast. Set to true only when you mean to write to that API.
# No effect on production builds.
VITE_ALLOW_LIVE_WRITES=false

# Live API (used when VITE_STAYS_DATA_SOURCE=api).
# One host serves both backend containers: Nginx routes
# `/api/travioghana/supplier/stays/**` to `stays-api` (the Stays branch image)
# and everything else — auth, chat, notifications, team — to `platform-api`.
# Do not add a separate stays origin unless the deployment introduces one.
VITE_API_BASE_URL=https://api.travioghana.com/api
VITE_AUTH_API_BASE_URL=https://api.travioghana.com/api
VITE_API_TIMEOUT=30000
# Automatic retries for failed reads (GET only — writes are never retried).
VITE_API_RETRY_ATTEMPTS=3
VITE_AUTH_PROVIDER=backend

# Google One Tap sign-in. Optional; leave blank to hide the button.
# This is the public client ID, not the client secret.
VITE_GOOGLE_CLIENT_ID=

# Storefront links used by the sidebar's "Live Site" control.
VITE_TRAVIO_GHANA_URL=https://travioghana.com
VITE_EXPEDITION_GO_URL=https://expeditiongotours.com

# Environment label: development | staging | production. Defaults to Vite's
# mode. `staging` shows the preview banner.
# VITE_APP_ENV=
