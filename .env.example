# ---------------------------------------------------------------------------
# Travio Ghana — Stays supplier dashboard
# Copy to `.env.local` and fill in only what you need.
# ---------------------------------------------------------------------------

# Where the Stays workspace reads its data from.
#   mock — the bundled preview dataset (no backend, no credentials)
#   api  — the live supplier API
# Defaults: `mock` in development, `api` in a production build.
VITE_STAYS_DATA_SOURCE=mock

# Live API. Only used when VITE_STAYS_DATA_SOURCE=api.
VITE_API_BASE_URL=https://api.travioghana.com/api
VITE_AUTH_API_BASE_URL=https://api.travioghana.com/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_AUTH_PROVIDER=firebase

# Sign-in. Google One Tap is optional; leave blank to hide the button.
VITE_GOOGLE_CLIENT_ID=

# Firebase is only needed for the live supplier sign-in flow.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Maps (property location picker / map preview).
VITE_MAPBOX_ACCESS_TOKEN=
VITE_GEOAPIFY_API_KEY=

# Storefront links used by the sidebar's "Live Site" control.
VITE_TRAVIO_GHANA_URL=https://travioghana.com
VITE_EXPEDITION_GO_URL=https://expeditiongotours.com

# Never put server-only secrets here. `VITE_*` values are inlined into the
# client bundle; `VITE_SERP_API_KEY` in particular is backend-only and the build
# fails if client code references it (see vite.config.ts).
